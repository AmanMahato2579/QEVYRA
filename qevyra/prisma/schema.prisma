generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// =============================================================================
// QEVYRA — unified schema
// -----------------------------------------------------------------------------
// Ownership map (see docs/QEVYRA_DATABASE.md):
//   CORE    — Business, User, Customer, BusinessCustomer, Plan, PlatformSetting,
//             AdminActivity                 (universal tenant + platform services)
//   WEBSITE — Website, WebsiteTheme
//   ORDER   — Restaurant profile + Menu/Category/MenuItem/MenuItemVariant,
//             Table/TableSession, Order/OrderItem/OrderSequence,
//             BookableService/Booking, Notification, PushSubscription
//   TRACK   — Workflow, WorkflowStep, Ticket, TicketStatusHistory
//
// Tenancy rule: `Business` is the universal tenant. The ORDER module keeps
// `restaurantId` during the transition (each Restaurant links 1:1 to its
// Business via Restaurant.businessId). Subscriptions/plan live on Business,
// never on the order profile.
// =============================================================================

// ─────────────────────────────── CORE ───────────────────────────────────────

enum BusinessType {
  RESTAURANT
  HOTEL
  HOMESTAY
  RETAIL
  SERVICE
  OTHER
  TAILOR
  DRY_CLEANING
  GARAGE
  CLEANING
  REPAIR
}

model Business {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  type        BusinessType @default(RESTAURANT)
  description String?
  logoUrl     String?
  coverUrl    String?
  phone       String?
  whatsapp    String?
  address     String?
  mapUrl      String?
  openingHours String?
  language    String       @default("EN")
  brandColor  String       @default("orange")
  isActive    Boolean      @default(true)

  // Platform subscription (single source of truth for plan access).
  plan                 String   @default("STAR")
  subscriptionStatus   String   @default("ACTIVE") // ACTIVE | EXPIRED | CANCELLED | SUSPENDED
  subscriptionStart    DateTime?
  subscriptionExpiresAt DateTime?
  neverExpires         Boolean  @default(true)
  autoOff              Boolean  @default(true)
  // Star (first-10 founding customers) — starNumber 1..10 marks STAR status
  starNumber           Int?
  starNote             String?
  // Lightweight per-customer overrides (JSON blobs, no relational explosion)
  featureOverrides     String?
  limitOverrides       String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // ORDER profile (1:1 during transition; a Business that only uses
  // Website/Track has no Restaurant row).
  restaurant Restaurant?
  users      User[]
  memberships BusinessMembership[]
  customers  BusinessCustomer[]
  website    Website?
  workflows  Workflow[]
  tickets    Ticket[]
  notificationEvents NotificationEvent[]
  locations  BusinessLocation[]
  // Product activation: which QEVYRA products the business is entitled to use.
  // This is the source of truth for feature/limit access (see plans.ts).
  products   BusinessProduct[]
  site       Site?
  siteHighlights SiteHighlight[]
  siteItems  SiteItem[]
  inventoryItems InventoryItem[]
  inventoryMovements InventoryMovement[]

  @@index([slug])
  @@index([type])
  @@index([plan])
}

// A physical place a business operates from. The first release usually has one
// location, but tables, rooms, courts, stock, bookings and staff assignments are
// location-scoped in the target model. This entity exists now so multi-location
// support is additive (add nullable `locationId` FKs later) rather than a
// schema fork. Exactly one location may be flagged `isPrimary`.
model BusinessLocation {
  id           String   @id @default(cuid())
  businessId   String
  name         String
  slug         String
  address      String?
  phone        String?
  mapUrl       String?
  openingHours String?
  isPrimary    Boolean  @default(false)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, slug])
  @@index([businessId])
  @@index([businessId, isActive])
}

// Platform product catalog (seeded by super admin, mirror of plan-catalog.ts).
// A Product is a FUNCTIONAL module a business can be granted (Website, Menu,
// Order, Track, …) — deliberately decoupled from the legacy billing tiers
// (BRONZE/SILVER/STAR) which remain on Business.plan for pricing/history only.
// featureKeys is a JSON array of feature keys the product unlocks; limitKeys a
// JSON object such as { "qrTables": 20, "workflows": 5 }.
model Product {
  id          ProductType @id
  name        String
  description String?
  featureKeys String      @default("[]")
  limitKeys   String      @default("{}")
  sortOrder   Int         @default(0)
  isVisible   Boolean     @default(true)
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  businesses BusinessProduct[]

  @@index([isVisible])
}

// Tenant-scoped product entitlement. isActive = the business currently has the
// product switched on (admins can toggle from the Super Admin business detail).
model BusinessProduct {
  id         String      @id @default(cuid())
  businessId String
  productId  ProductType
  isActive   Boolean     @default(true)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id])

  @@unique([businessId, productId])
  @@index([businessId])
  @@index([productId])
}

model User {
  id           String      @id @default(cuid())
  email        String      @unique
  name         String
  passwordHash String
  role         UserRole    @default(RESTAURANT_ADMIN)
  businessId   String?
  restaurantId String?
  // Bumped on every password reset / forced logout so previously-issued JWTs
  // are rejected at the next `jwt` callback check.
  tokenVersion Int          @default(0)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  business   Business?   @relation(fields: [businessId], references: [id], onDelete: SetNull)
  restaurant Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  memberships BusinessMembership[]
  inventoryMovements InventoryMovement[] @relation("InventoryMovementActor")

  @@index([email])
  @@index([businessId])
  @@index([restaurantId])
}

// Staff membership: links a login (User) to a tenant (Business) with a
// business-scoped staff role. A user's effective permissions inside a business
// come from here; `User.role` remains the platform login role for backward
// compatibility. Additive — existing owner logins keep working with no rows.
model BusinessMembership {
  id         String    @id @default(cuid())
  userId     String
  businessId String
  role       StaffRole @default(OWNER)
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([userId, businessId])
  @@index([businessId])
  @@index([userId])
}

// Global customer identity. NEVER a per-tenancy table: a person is one record
// and per-business data hangs off BusinessCustomer (privacy + isolation).
model Customer {
  id        String           @id @default(cuid())
  phone     String?
  email     String?
  name      String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  businesses BusinessCustomer[]

  @@index([phone])
  @@index([email])
}

// Tenant-scoped customer membership. Every touchpoint (booking, ticket, order)
// resolves through this link so Business A never reads Business B's customers.
model BusinessCustomer {
  id          String   @id @default(cuid())
  businessId  String
  customerId  String
  label       String?
  notes       String?
  visits      Int      @default(0)
  lastVisitAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([businessId, customerId])
  @@index([businessId])
  @@index([customerId])
}

enum UserRole {
  SUPER_ADMIN
  RESTAURANT_ADMIN
  TRACKING_ADMIN
}

// Business-scoped staff roles. Distinct from the three platform login roles
// above; a BusinessMembership's role governs what a login may do in one tenant.
enum StaffRole {
  OWNER
  MANAGER
  FRONT_DESK
  WAITER
  KITCHEN
  TECHNICIAN
  INVENTORY
  ACCOUNTANT
}

// QEVYRA functional products (what a business is entitled to USE), distinct
// from the legacy billing tiers (BRONZE/SILVER/STAR) stored on Business.plan.
enum ProductType {
  WEBSITE
  MENU
  ORDER
  TRACK
  TRACK_PRO
}

// Editable plan catalog. featureKeys is a JSON array (or ["ALL_CURRENT_FEATURES"]
// for STAR so new platform features are picked up automatically). limitKeys is a
// JSON object such as { "qrTables": 20, "workflows": 2 }. Future plans (e.g.
// GOLD) are stored here with isVisible=false until they are ready to be exposed.
model Plan {
  id           String    @id
  name         String
  description  String?
  priceMonthly Decimal?  @db.Decimal(10, 2)
  priceYearly  Decimal?  @db.Decimal(10, 2)
  featureKeys  String    @default("[]")
  limitKeys    String    @default("{}")
  sortOrder    Int       @default(0)
  isVisible    Boolean   @default(true)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// Lightweight audit trail for important Super Admin actions.
model AdminActivity {
  id             String   @id @default(cuid())
  action         String
  businessId     String?
  businessName   String?
  restaurantId   String?
  restaurantName String?
  detail         String?
  actorEmail     String?
  createdAt      DateTime @default(now())

  @@index([businessId])
  @@index([restaurantId])
  @@index([createdAt])
}

// Small key/value store for platform-level settings (defaults, branding).
model PlatformSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────── WEBSITE ────────────────────────────────────

model Website {
  id           String  @id @default(cuid())
  businessId   String  @unique
  themeId      String?
  isPublished  Boolean @default(false)

  // SEO
  metaTitle       String?
  metaDescription String?

  // Hero
  heroTitle    String?
  heroSubtitle String?
  heroImageUrl String?
  heroCtaLabel String?
  heroCtaLink  String?

  // About
  aboutTitle String?
  aboutText  String?
  aboutImageUrl String?

  // Services / offerings blurb
  servicesTitle String?
  servicesText  String?

  // Contact + footer
  contactPhone String?
  contactEmail String?
  addressText  String?
  mapUrl       String?
  footerText   String?

  // Google review — the "Leave a review" button on the public website links
  // straight to the business's Google Maps review page. Optional.
  googleReviewUrl String?

  // Social profile links (structured JSON, e.g. [{ "kind": "facebook", "url": … }]).
  // Planned Phase W2 for the public footer — additive, never fabricated for a
  // business that hasn't provided them.
  socialLinks String?

  // Google rating snapshot (phase W2): average star rating + review count for
  // the "reviews" badge. Null by default — the number is NEVER invented.
  googleRating      Float?
  googleRatingCount Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  theme    WebsiteTheme? @relation(fields: [themeId], references: [id], onDelete: SetNull)
}

// Reusable website design presets (catalog seeded by super admin).
model WebsiteTheme {
  id           String   @id @default(cuid())
  name         String
  description  String?
  primaryColor String   @default("#f97316")
  background   String   @default("#0b0f19")
  fontFamily   String?  @default("inter")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  websites Website[]

  @@index([isActive])
}

// ─────────────────────────────── ORDER ──────────────────────────────────────
// The working QR-menu product. Keeps `restaurantId` during the transition;
// `Restaurant.businessId` links the order profile to the universal tenant.

model Restaurant {
  id                     String             @id @default(cuid())
  businessId             String?            @unique
  name                   String
  slug                   String             @unique
  description            String?
  logoUrl                String?
  address                String?
  phone                  String?
  currency               String             @default("Rs.")
  openingHours           String?
  language               String             @default("EN")
  taxRate                Decimal            @default(0) @db.Decimal(5, 2)
  isTaxEnabled           Boolean            @default(false)
  serviceChargeRate      Decimal            @default(0) @db.Decimal(5, 2)
  isServiceChargeEnabled Boolean            @default(false)
  tableLimit             Int                @default(20)
  isActive               Boolean            @default(true)
  bookingsEnabled        Boolean            @default(false)
  brandColor             String             @default("orange")
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  business          Business?          @relation(fields: [businessId], references: [id], onDelete: SetNull)
  categories        Category[]
  menuItems         MenuItem[]
  notifications     Notification[]
  pushSubscriptions PushSubscription[]
  orders            Order[]
  tables            Table[]
  tableSessions     TableSession[]
  users             User[]
  bookableServices  BookableService[]
  bookings          Booking[]

  @@index([slug])
  @@index([businessId])
}

model Table {
  id            String         @id @default(cuid())
  restaurantId  String
  tableNumber   Int
  qrToken       String         @unique @default(cuid())
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  restaurant    Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  tableSessions TableSession[]

  @@unique([restaurantId, tableNumber])
  @@index([restaurantId])
  @@index([qrToken])
}

model TableSession {
  id                 String             @id @default(cuid())
  restaurantId       String
  tableId            String
  status             TableSessionStatus @default(ACTIVE)
  customerName       String?
  applyTax           Boolean            @default(true)
  applyServiceCharge Boolean            @default(true)
  startedAt          DateTime           @default(now())
  closedAt           DateTime?
  orders             Order[]
  bookings           Booking[]
  restaurant         Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  table              Table              @relation(fields: [tableId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@index([tableId])
  @@index([status])
  @@index([restaurantId, status])
  @@index([status, startedAt])
}

model Category {
  id           String     @id @default(cuid())
  restaurantId String
  name         String
  description  String?
  isActive     Boolean    @default(true)
  sortOrder    Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  menuItems    MenuItem[]

  @@index([restaurantId])
}

model MenuItem {
  id                  String            @id @default(cuid())
  restaurantId        String
  categoryId          String
  name                String
  description         String?
  price               Decimal           @db.Decimal(10, 2)
  imageUrl            String?
  ingredients         String?
  discountPercent     Int               @default(0)
  isAvailable         Boolean           @default(true)
  sortOrder           Int               @default(0)
  hasSpicyOption      Boolean           @default(false)
  hasNoteOption       Boolean           @default(true)
  requiresPreparation Boolean           @default(true)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  foodType            String?
  category            Category          @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  restaurant          Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  variants            MenuItemVariant[]
  orderItems          OrderItem[]
  recipe              MenuItemRecipe[]

  @@index([restaurantId])
  @@index([categoryId])
}

// Junction: which inventory items one unit of this menu item consumes, and how
// much. When an order is accepted the platform records USED movements for the
// aggregated recipe lines; cancellations/rejections write compensating
// ADJUSTMENT movements. Stock bookkeeping is best-effort and never blocks the
// order flow.
model MenuItemRecipe {
  id              String        @id @default(cuid())
  menuItemId      String
  inventoryItemId String
  quantity        Decimal       @default(1) @db.Decimal(12, 3)
  createdAt       DateTime      @default(now())

  menuItem      MenuItem      @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@unique([menuItemId, inventoryItemId])
  @@index([inventoryItemId])
}

model MenuItemVariant {
  id          String      @id @default(cuid())
  menuItemId  String
  name        String
  price       Decimal     @db.Decimal(10, 2)
  isAvailable Boolean     @default(true)
  sortOrder   Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  foodType    String?
  menuItem    MenuItem    @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  orderItems  OrderItem[]

  @@unique([menuItemId, name])
  @@index([menuItemId])
}

model Order {
  id              String       @id @default(cuid())
  orderNumber     Int
  restaurantId    String
  tableSessionId  String
  customerToken   String
  // Optional client-generated idempotency key (one per session): submitting
  // the same key twice returns the original order instead of a duplicate.
  clientRequestId String?
  source          OrderSource  @default(CUSTOMER)
  status          OrderStatus  @default(PENDING)
  statusChangedAt DateTime     @default(now())
  subtotal        Decimal      @default(0) @db.Decimal(10, 2)
  taxAmount       Decimal      @default(0) @db.Decimal(10, 2)
  serviceChargeAmount Decimal @default(0) @db.Decimal(10, 2)
  total           Decimal      @db.Decimal(10, 2)
  notes           String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  restaurant      Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  tableSession    TableSession @relation(fields: [tableSessionId], references: [id], onDelete: Cascade)
  orderItems      OrderItem[]
  statusHistory   OrderStatusHistory[]

  @@unique([restaurantId, orderNumber])
  @@unique([tableSessionId, clientRequestId])
  @@index([restaurantId])
  @@index([tableSessionId])
  @@index([status])
  @@index([customerToken])
  @@index([restaurantId, createdAt])
  @@index([restaurantId, status, statusChangedAt])
}

// Immutable audit trail of an order's status lifecycle (created → accepted →
// completed, or rejected). Mirrors TRACK's TicketStatusHistory. Written inside
// the same transaction as the status change so history can never diverge from
// the order; rows are never updated or deleted (cascade-removed with the order).
model OrderStatusHistory {
  id         String      @id @default(cuid())
  orderId    String
  fromStatus OrderStatus?
  toStatus   OrderStatus
  note       String?
  createdAt  DateTime    @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([orderId, createdAt])
}

model OrderItem {
  id                String           @id @default(cuid())
  orderId           String
  menuItemId        String
  menuItemName      String
  menuItemVariantId String?
  variantName       String?
  quantity          Int
  unitPrice         Decimal          @db.Decimal(10, 2)
  subtotal          Decimal          @db.Decimal(10, 2)
  isSpicy           Boolean          @default(false)
  note              String?
  status            OrderItemStatus  @default(NEW)
  servedQuantity    Int              @default(0)
  cancelledReason   String?
  createdAt         DateTime         @default(now())
  menuItem          MenuItem         @relation(fields: [menuItemId], references: [id])
  menuItemVariant   MenuItemVariant? @relation(fields: [menuItemVariantId], references: [id])
  order             Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([status])
  @@index([menuItemId])
}

model OrderSequence {
  restaurantId String @id
  lastNumber   Int    @default(1000)
}

model Notification {
  id           String           @id @default(cuid())
  restaurantId String
  type         NotificationType
  title        String
  message      String
  link         String?
  read         Boolean          @default(false)
  createdAt    DateTime         @default(now())
  restaurant   Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, read])
  @@index([restaurantId])
  @@index([restaurantId, createdAt])
}

model BookableService {
  id                  String              @id @default(cuid())
  restaurantId        String
  name                String
  type                BookableServiceType @default(OTHER)
  description         String?
  price               Decimal             @db.Decimal(10, 2)
  imageUrl            String?
  capacity            Int                 @default(2)
  venueCount          Int                 @default(1)
  slotDurationMinutes Int                 @default(60)
  openingMinutes      Int                 @default(480)
  closingMinutes      Int                 @default(1380)
  isActive            Boolean             @default(true)
  sortOrder           Int                 @default(0)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  restaurant          Restaurant          @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  bookings            Booking[]

  @@index([restaurantId])
  @@index([restaurantId, isActive])
}

model Booking {
  id              String          @id @default(cuid())
  restaurantId    String
  serviceId       String
  tableSessionId  String?
  contactName     String
  contactPhone    String
  note            String?
  bookingDate     String // calendar day "YYYY-MM-DD" in restaurant time
  startMinutes    Int // minutes from midnight when the slot starts
  durationMinutes Int
  guests          Int             @default(1)
  status          BookingStatus   @default(PENDING)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  restaurant      Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  service         BookableService @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  tableSession    TableSession?   @relation(fields: [tableSessionId], references: [id], onDelete: SetNull)
  statusHistory   BookingStatusHistory[]

  @@index([restaurantId])
  @@index([serviceId])
  @@index([restaurantId, bookingDate])
  @@index([restaurantId, status])
  @@index([serviceId, bookingDate, status])
}

// Immutable audit trail of a booking's status lifecycle (requested → accepted →
// completed, or rejected/cancelled). Written in the same transaction as the
// status change; rows are append-only and cascade-removed with the booking.
model BookingStatusHistory {
  id         String        @id @default(cuid())
  bookingId  String
  fromStatus BookingStatus?
  toStatus   BookingStatus
  note       String?
  createdAt  DateTime      @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([bookingId, createdAt])
}

model PushSubscription {
  id           String     @id @default(cuid())
  restaurantId String
  endpoint     String     @unique
  p256dh       String
  auth         String
  userAgent    String?
  createdAt    DateTime   @default(now())
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
}

enum OrderStatus {
  PENDING
  ACCEPTED
  PREPARING
  READY
  COMPLETED
  REJECTED
}

enum OrderItemStatus {
  NEW
  PREPARING
  SERVED
  CANCELLED
}

enum OrderSource {
  CUSTOMER
  WAITER
}

enum TableSessionStatus {
  ACTIVE
  CLOSED
}

enum NotificationType {
  NEW_ORDER
  NEW_TABLE_SESSION
  ASSISTANCE_REQUEST
  ORDER_STATUS
  NEW_BOOKING
}

enum BookableServiceType {
  ROOM
  POOL
  TABLE_GAME
  ADVENTURE
  OTHER
}

enum BookingStatus {
  PENDING
  ACCEPTED
  REJECTED
  COMPLETED
  CANCELLED
}

// ─────────────────────────────── TRACK ──────────────────────────────────────

// A process definition (e.g. "Garage service") with a short code prefix used to
// build human-friendly tracking codes like GAR-0001. Owned by a Business.
model Workflow {
  id          String   @id @default(cuid())
  businessId  String
  name        String
  description String?
  codePrefix  String   @default("TRK")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  steps    WorkflowStep[]
  tickets  Ticket[]
  sequence WorkflowSequence?

  @@unique([businessId, codePrefix])
  @@index([businessId])
  @@index([businessId, isActive])
}

// Atomic per-workflow ticket counter (mirrors OrderSequence). Upserted with
// `increment` so concurrent ticket creation can never reuse a ticket number.
model WorkflowSequence {
  workflowId       String @id
  businessId       String
  lastTicketNumber Int    @default(1000)

  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

// Ordered step of a workflow. `isReadyStep` marks the terminal "ready/collect"
// state so ticket progress can render a completion state without guessing.
model WorkflowStep {
  id          String   @id @default(cuid())
  workflowId  String
  name        String
  description String?
  sortOrder   Int
  isReadyStep Boolean  @default(false)
  createdAt   DateTime @default(now())

  workflow       Workflow             @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  tickets        Ticket[]
  statusHistory  TicketStatusHistory[] @relation("historyFromStep")
  historyTo      TicketStatusHistory[] @relation("historyToStep")

  @@unique([workflowId, sortOrder])
  @@index([workflowId])
}

// One tracked job/case through a workflow. `trackingCode` (e.g. GAR-0001) is the
// human-friendly reference shown to staff/customers; `publicToken` is the
// high-entropy, unguessable secret embedded in customer QR links so the public
// tracking page can never be enumerated by guessing a sequential code.
model Ticket {
  id           String   @id @default(cuid())
  businessId   String
  workflowId   String
  ticketNumber Int
  trackingCode String   @unique
  publicToken  String   @unique

  customerName  String?
  customerPhone String?
  itemSummary   String?
  notes         String?

  status          TicketStatus @default(PLACED)
  currentStepId   String?
  statusChangedAt DateTime     @default(now())
  completedAt     DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  business     Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  workflow     Workflow           @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  currentStep  WorkflowStep?      @relation(fields: [currentStepId], references: [id], onDelete: SetNull)
  statusHistory TicketStatusHistory[]
  items         TicketItem[]

  @@unique([businessId, ticketNumber])
  @@unique([workflowId, ticketNumber])
  @@index([businessId])
  @@index([workflowId])
  @@index([trackingCode])
  @@index([status])
  @@index([businessId, createdAt])
  @@index([businessId, status])
  @@index([status, statusChangedAt])
  @@index([createdAt])
}

// Full immutable history of a ticket's lifecycle (step + status transitions).
model TicketStatusHistory {
  id          String   @id @default(cuid())
  ticketId    String
  fromStepId  String?
  toStepId    String?
  fromStatus  TicketStatus?
  toStatus    TicketStatus
  note        String?
  createdAt   DateTime @default(now())

  ticket   Ticket        @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  fromStep WorkflowStep? @relation("historyFromStep", fields: [fromStepId], references: [id], onDelete: SetNull)
  toStep   WorkflowStep? @relation("historyToStep", fields: [toStepId], references: [id], onDelete: SetNull)

  @@index([ticketId])
  @@index([ticketId, createdAt])
}

// Optional structured line items attached to a Ticket (e.g. "2 × suit
// stitching"). Free-form per ticket, never shared across tickets, and separate
// from the free-text `Ticket.itemSummary`. Prices are optional and never
// invented — a line with no `unitPrice` simply shows no amount.
model TicketItem {
  id          String   @id @default(cuid())
  ticketId    String
  name        String
  description String?
  quantity    Int      @default(1)
  unitPrice   Decimal? @db.Decimal(10, 2)
  currency    String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([ticketId, sortOrder])
}

enum TicketStatus {
  PLACED
  IN_PROGRESS
  READY
  COMPLETED
  CANCELLED
}

// =============================================================================
// SITES — template-driven public storefront module (Phase A)
// =============================================================================

enum SiteType {
  GENERAL
  TRACKING
  MENU
}

model Site {
  id               String          @id @default(cuid())
  businessId       String          @unique
  slug             String          @unique
  type             SiteType
  name             String
  shortDescription String?
  aboutText        String?
  storyText        String?
  logoUrl          String?
  heroImageUrl     String?
  primaryColor     String?
  phone            String?
  whatsapp         String?
  addressText      String?
  mapUrl           String?
  openingHours     String?
  googleReviewUrl  String?
  socialLinks      Json?
  isPublished      Boolean         @default(false)
  enableItems      Boolean         @default(false)
  enableTrackOrder Boolean         @default(false)
  enableAds        Boolean         @default(false)
  enableBooking    Boolean         @default(false)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  business         Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  highlights       SiteHighlight[]
  items            SiteItem[]

  @@index([slug])
  @@index([businessId])
}

model SiteHighlight {
  id          String   @id @default(cuid())
  siteId      String
  businessId  String
  title       String
  description String?
  imageUrl    String?
  sortOrder   Int      @default(0)

  site        Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([siteId, sortOrder])
  @@index([businessId])
}

model SiteItem {
  id          String   @id @default(cuid())
  siteId      String
  businessId  String
  name        String
  description String?
  priceText   String?
  imageUrl    String?
  category    String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)

  site        Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([siteId, sortOrder])
  @@index([businessId])
}

model SiteAd {
  id        String   @id @default(cuid())
  title     String
  imageUrl  String
  linkUrl   String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
}

// ─── Inventory (Suite A) ─────────────────────────────────────────────────────
// Tenant-scoped stock control. An InventoryItem is a thing a business counts
// (ingredient, retail good, spare part). Stock is NEVER edited directly: every
// change is an InventoryMovement, which keeps a running balance (stockAfter) and
// the actor/time, so the ledger doubles as an audit trail. `currentStock` is a
// cached roll-up maintained by the movement service inside one transaction.
enum InventoryMovementType {
  RECEIVED // stock in (purchase / delivery)
  USED // consumed or sold
  WASTE // spoilage / loss
  ADJUSTMENT // manual count correction (quantity may be + or -)
}

model InventoryItem {
  id               String   @id @default(cuid())
  businessId       String
  name             String
  sku              String?
  unit             String   @default("unit")
  currentStock     Decimal  @default(0) @db.Decimal(12, 3)
  reorderThreshold Decimal  @default(0) @db.Decimal(12, 3)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  business  Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  movements InventoryMovement[]
  recipes   MenuItemRecipe[]

  @@unique([businessId, sku])
  @@index([businessId])
  @@index([businessId, isActive])
}

model InventoryMovement {
  id         String                @id @default(cuid())
  businessId String
  itemId     String
  type       InventoryMovementType
  // Signed effect on stock: RECEIVED > 0, USED/WASTE < 0, ADJUSTMENT either.
  quantity   Decimal               @db.Decimal(12, 3)
  stockAfter Decimal               @db.Decimal(12, 3)
  note       String?
  actorId    String?
  createdAt  DateTime              @default(now())

  business Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  item     InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  actor    User?         @relation("InventoryMovementActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([businessId, createdAt])
  @@index([itemId, createdAt])
}

// ─── Outbound notifications (platform core) ──────────────────────────────────
// A durable, honest log of every external message the platform intends to send
// (WhatsApp/SMS/email). The row is written BEFORE any network call, so a message
// that cannot be delivered because no provider is connected is recorded as
// NOT_CONFIGURED rather than silently lost. Provider adapters flip it to
// SENT/FAILED. No business state is stored here — WhatsApp/SMS are channels.
enum NotificationChannel {
  WHATSAPP
  SMS
  EMAIL
}

enum NotificationDeliveryStatus {
  PENDING
  SENT
  FAILED
  NOT_CONFIGURED
}

model NotificationEvent {
  id         String                     @id @default(cuid())
  businessId String
  channel    NotificationChannel
  status     NotificationDeliveryStatus @default(PENDING)
  recipient  String
  subject    String?
  body       String
  // Adapter id that owns this channel (e.g. "whatsapp-cloud"); null if none exists.
  provider   String?
  // What triggered it, e.g. refType "ticket" + refId.
  refType    String?
  refId      String?
  error      String?
  attempts   Int                        @default(0)
  sentAt     DateTime?
  createdAt  DateTime                   @default(now())
  updatedAt  DateTime                   @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, createdAt])
  @@index([businessId, status])
  @@index([refType, refId])
}